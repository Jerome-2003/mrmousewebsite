# Copy to .env.local for local development. Real values go in .env.local
# (gitignored) and in your host's environment variable settings — never here.

# Resend API key (https://resend.com/api-keys). Required for the contact and
# waitlist forms to send mail. Server-only — never exposed to the browser.
RESEND_API_KEY=

# Where contact-form and waitlist submissions are delivered. Optional —
# defaults to info@horde-m.name.ng (src/data/horde.ts CONTACT.email) if unset.
# CONTACT_TO_EMAIL=info@horde-m.name.ng

# The address mail is sent FROM. Resend only allows sending from a domain
# you've verified in the Resend dashboard (Domains -> Add Domain, then add the
# DNS records it gives you at your registrar). Until horde-m.name.ng is
# verified there, leave this unset — it falls back to Resend's own onboarding
# address, which works with zero setup but looks less official to recipients.
# RESEND_FROM_EMAIL=Horde-M <info@horde-m.name.ng>
